// Money is stored as BigInt in minor units (kobo, cents). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A founder signs in once and can run several companies.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?   // null for founders who only use Google or email links
  emailVerifiedAt DateTime?
  googleSub       String?   @unique // Google account id, set on first Google sign-in
  createdAt       DateTime  @default(now())
  companies       Company[]
  sessions        Session[]
}

// One-time links sent by email. Only the SHA-256 of the token is stored.
model AuthToken {
  id        String    @id // sha256 of the token
  kind      String    // LOGIN | RESET | VERIFY
  email     String
  userId    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, kind, createdAt])
}

// Dev and test inbox: emails land here when no email provider is configured.
model DevEmail {
  id      String   @id @default(cuid())
  to      String
  subject String
  text    String
  link    String?
  sentAt  DateTime @default(now())
}

model Session {
  id              String   @id // sha256 of the cookie token, never the token itself
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompanyId String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
}

model Company {
  id               String  @id @default(cuid())
  ownerId          String
  owner            User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  baseCurrency     String  @default("NGN")
  currencies       String  @default("NGN,USD") // wallets this company runs, comma list
  blaaizCustomerId String?
  // Live-mode credentials, encrypted with BURSAR_SECRET_KEY (AES-256-GCM). Never plain text.
  blaaizClientId        String?
  blaaizClientSecretEnc String?
  blaaizWebhookSecretEnc String?
  paused           Boolean @default(false)
  // Last automatic Blaaiz setup (wallet discovery, funding account, webhooks).
  blaaizConnectedAt DateTime?
  blaaizConnectNote String?
  createdAt        DateTime @default(now())
}

model Wallet {
  id             String   @id @default(cuid())
  companyId      String
  blaaizWalletId String
  currency       String
  label          String
  balance        BigInt
  // Virtual bank account used to fund this wallet by bank transfer (NGN).
  vaAccountNumber String?
  vaAccountName   String?
  vaBankName      String?
  updatedAt      DateTime @updatedAt

  @@unique([companyId, currency])
}

model WalletSnapshot {
  id             String   @id @default(cuid())
  companyId      String
  blaaizWalletId String
  currency       String
  balance        BigInt
  takenAt        DateTime @default(now())
  cycleId        String?
}

model RateSnapshot {
  id        String   @id @default(cuid())
  pair      String   // e.g. USDNGN = NGN per 1 USD
  rate      Float    // a rate, not money
  fetchedAt DateTime @default(now())
}

model Payee {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  category      String   // PAYROLL | CRITICAL_VENDOR | SAAS | DOMAIN | VENDOR | UTILITY
  currency      String
  method        String   @default("bank_transfer") // bank_transfer | mobile_money
  bankId        String?
  bankName      String?
  accountNumber String?
  accountName   String?
  phone         String?
  operatorId    String?
  // Blaaiz customer record (setup). Blaaiz requires KYC fields to create one.
  email            String?
  country          String?
  idType           String?
  idNumber         String?
  blaaizCustomerId String?
  allowlisted   Boolean  @default(false)
  critical      Boolean  @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  payments      ScheduledPayment[]
}

model ScheduledPayment {
  id                String   @id @default(cuid())
  companyId         String
  payeeId           String
  payee             Payee    @relation(fields: [payeeId], references: [id])
  amount            BigInt
  amountType        String   @default("to") // to | from
  currency          String
  dueDate           String   // YYYY-MM-DD
  recurrence        String   @default("NONE") // NONE | WEEKLY | MONTHLY
  priority          Int
  critical          Boolean
  status            String   @default("SCHEDULED") // SCHEDULED | DEFERRED | PROPOSED | EXECUTING | PAID | FAILED | CANCELLED
  deferCount        Int      @default(0)
  merchantReference String   @unique
  memo              String?
  blaaizTransactionId String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Policy {
  companyId           String  @id
  perPaymentCap       String  // JSON {"NGN": minor, "USD": minor}
  dailyCapNgn         BigInt
  perSwapCapNgn       BigInt
  buffer              String  // JSON {"NGN": minor, "USD": minor}
  allowedPairs        String  // comma list, e.g. "NGN>USD,USD>NGN"
  maxRateDeviationPct Float
  horizonDays         Int
  maxDeferDays        Int
  autoExecute         Boolean
  updatedAt           DateTime @updatedAt
}

model Cycle {
  id         String    @id @default(cuid())
  companyId  String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  trigger    String    // SCHEDULE | MANUAL | WEBHOOK
  summary    String?
  error      String?
  actions    Action[]
}

model Action {
  id           String   @id @default(cuid())
  companyId    String
  number       Int
  cycleId      String?
  cycle        Cycle?   @relation(fields: [cycleId], references: [id])
  type         String   // PAY | SWAP | SWAP_THEN_PAY | DEFER | ESCALATE | HOLD
  paymentId    String?
  payload      String   // JSON
  reasonCode   String
  explanation  String
  policyResult String   // JSON
  status       String   // PENDING | APPROVED | REJECTED | EXECUTED | FAILED | SKIPPED
  auto         Boolean  @default(false)
  decidedBy    String?  // BURSAR | OWNER
  decidedAt    DateTime?
  createdAt    DateTime @default(now())
  executions   Execution[]

  @@unique([companyId, number])
}

model Execution {
  id                  String   @id @default(cuid())
  companyId           String
  actionId            String
  action              Action   @relation(fields: [actionId], references: [id])
  kind                String   // SWAP | PAYOUT
  idempotencyKey      String
  request             String   // JSON
  response            String?  // JSON
  blaaizTransactionId String?
  status              String   // PENDING | PROCESSING | SUCCESSFUL | FAILED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([idempotencyKey])
}

// Local ledger: every money movement Bursar knows about, signed, per wallet.
model LedgerEntry {
  id                  String   @id @default(cuid())
  companyId           String
  currency            String
  kind                String   // PAYOUT | FEE | SWAP_OUT | SWAP_IN | DEPOSIT | REFUND
  amount              BigInt   // signed minor units: negative leaves the wallet
  memo                String
  actionId            String?
  paymentId           String?
  blaaizTransactionId String?
  at                  DateTime @default(now())

  @@index([companyId, currency, at])
}

model WebhookEvent {
  id                   String    @id @default(cuid())
  companyId            String?
  eventType            String
  rawBody              String
  signatureValid       Boolean
  dedupeKey            String?
  processedAt          DateTime?
  relatedTransactionId String?
  note                 String?
  receivedAt           DateTime  @default(now())

  @@index([dedupeKey])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  at      DateTime @default(now())
  actor   String   // BURSAR | OWNER | BLAAIZ
  message String
  refType String?
  refId   String?
}

// Mock-mode Blaaiz state. Only src/blaaiz/mock.ts touches these tables.
model MockWallet {
  id        String @id
  companyId String
  currency  String
  balance   BigInt

  @@unique([companyId, currency])
}

model MockTransaction {
  id                String   @id
  companyId         String
  type              String   // payout | swap | collection
  status            String
  currency          String
  amount            BigInt
  fee               BigInt
  rate              Float?
  walletId          String
  merchantReference String?
  payload           String
  createdAt         DateTime @default(now())
}
