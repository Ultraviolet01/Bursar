# Copy to .env and fill in. Never commit real values.
BLAAIZ_MODE=mock                      # mock | live
BLAAIZ_API_URL=https://api-dev.blaaiz.com
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
BLAAIZ_OAUTH_SCOPE=                   # blank = SDK requests full scope (ok in dev)
BLAAIZ_WEBHOOK_SECRET=                # webhook signing_secret from the dashboard
BLAAIZ_CUSTOMER_ID=                   # our verified customer id, used on payouts
DATABASE_URL=file:./bursar.db
CYCLE_CRON=*/10 * * * *               # every 10 minutes; cycles also run when a bill is added, a deposit lands or a swap is approved
OPENAI_OR_ANTHROPIC_KEY=              # optional, explanations only (not used yet)
BURSAR_SECRET_KEY=                    # 32+ random characters; encrypts each company's Blaaiz secrets at rest
CRON_SECRET=                          # optional; lets an external scheduler POST /api/cycle for every company
APP_URL=                              # public URL, e.g. https://bursar-beta.vercel.app (Google redirects back here)
GOOGLE_CLIENT_ID=                     # "Continue with Google" (Google Cloud Console > OAuth client, web app)
GOOGLE_CLIENT_SECRET=                 # redirect URI to register: <APP_URL>/auth/google/callback
ENABLE_TEST_LOGIN=                    # 1 = local test sign-in without Google (browser test, dev). Always off on Vercel.
